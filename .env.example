# Copy to .env on the VPS and fill in.
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
SERVER_SECRET=change-me-long-random
# Domain with an A record pointing at this VPS (Caddy gets certs automatically)
DOMAIN=music.example.com
# Folder on the VPS holding your music (mounted read-only into the server)
MUSIC_DIR=/srv/music
# Public origin of the server — used for OAuth redirect URIs
PUBLIC_URL=https://music.example.com
# Spotify mirror (optional): create an app at developer.spotify.com and register
# the redirect URI  $PUBLIC_URL/spotify/callback
SPOTIFY_CLIENT_ID=
